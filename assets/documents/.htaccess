# Prevent script execution in upload directory
<FilesMatch "(?i)\.(php[0-9]?|pht|phtm|phtml|phps|phpt|phar|inc|pl|py|cgi|sh|bash|shtml?|svgz?)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Deny,Allow
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
